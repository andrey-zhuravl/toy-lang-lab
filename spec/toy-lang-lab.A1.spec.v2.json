  "make_targets": {
    "build-data": "python -m tlg.cli build-data conf=${CONF:-conf/data/toy_small.yaml} out=${OUT:-out/dev}",
    "smoke": "pytest -q tests/e2e/test_smoke.py",
    "fmt": "ruff --fix && black .",
    "lint": "ruff . && black --check .",
    "typecheck": "mypy --strict tlg",
    "test": "pytest -q",
    "release": "python -m build && echo tag v0.1.0"
  },
  "commit_policy": {
    "rules": [
      "One logical change per commit",
      "Tests in same PR",
      "Reference task ID",
      "English commit messages"
    ],
    "example": "feat(writer): A1-05 add parquet writer + stable hashing"
  },
  "acceptance": {
