{
  "version": "json.v2",
  "id": "toy-lang-lab.A2",
  "title": "Toy-Lang-Lab · Stage A2 · Tokenizers, Dictionaries, Embeddings, Catalog & Performance",
  "owner": {
    "tech_lead": "Andrei",
    "reviewers": [
      "Viktor Volkov",
      "Kirill Zhuravlev"
    ],
    "labels": [
      "lab",
      "data-gen",
      "python",
      "mlops",
      "reproducibility",
      "tokenizer",
      "embeddings"
    ]
  },
  "differences_from_A1": [
    "Learned tokenizers (BPE/WordPiece) training & deterministic application (given fixed seed + tiebreak rules).",
    "Dictionary generator (controlled lexicons; per-domain vocabulary).",
    "Optional fixed embeddings (char/word averages or seeded random) with manifest + hashing.",
    "Dataset contract v1.1: optional tokenization/ids fields + tokenizer/model hashes.",
    "Parallel generation + streaming writer for throughput.",
    "Dataset catalog (local YAML) + GardenKeeper linkage; optional MinIO/MLflow artifact push."
  ],
  "goals": [
    "Train and apply a tiny learned tokenizer and produce datasets augmented with tokens/ids as configured.",
    "Generate dictionaries and (optionally) fixed embeddings with deterministic manifests and hashes.",
    "Improve performance and reproducibility (parallelism + caching) and register datasets in a local catalog.",
    "Keep CLI/Hydra/MLflow surfaces consistent with A1; extend minimally."
  ],
  "non_goals": [
    "Training neural networks (remains in tiny-transformer-lab).",
    "Large-scale distributed generation (A3+).",
    "Tokenizer research beyond BPE/WordPiece baselines."
  ],
  "deliverables": {
    "artifacts": [
      "out/<run>/train.jsonl|parquet, valid.*, test.* (may include tokens/ids fields)",
      "out/<run>/manifest.json (v1.1 with tokenizer/dict/embeddings hashes)",
      "artifacts/tokenizers/<name>/{vocab.json, merges.txt|sp.model} (+ tokenizer_manifest.json)",
      "artifacts/dicts/<name>.json (with dict_manifest.json)",
      "artifacts/embeddings/<name>.parquet (with emb_manifest.json)",
      "catalog/datasets.yml (local catalog)",
      "MLflow run(s) with params + artifacts when enabled"
    ],
    "cli_commands": [
      "tlg dict build conf=conf/dict/en_basic.yaml out=artifacts/dicts/…",
      "tlg tok train conf=conf/tokenizer/bpe_tiny.yaml data=out/dev/train.jsonl out=artifacts/tokenizers/bpe_tiny",
      "tlg tok apply model=artifacts/tokenizers/bpe_tiny tokenizer=bpe in=out/dev/train.jsonl out=out/dev_tok/train.tok.jsonl",
      "tlg embed build conf=conf/embeddings/fixed_char.yaml out=artifacts/embeddings/…",
      "tlg build-data conf=conf/data/toy_medium.yaml out=out/dev format=jsonl",
      "tlg validate path=out/dev",
      "tlg catalog add path=out/dev"
    ]
  },
  "repo": {
    "name": "toy-lang-lab",
    "package": "tlg",
    "spec_path": "spec/toy-lang-lab.A2.spec.v2.json",
    "requires": [
      "A1 complete and green CI"
    ],
    "layout_additions": {
      "tlg/tokenizers_learned.py": "BPE/WordPiece training and apply",
      "tlg/dictionaries.py": "controlled lexicon builder",
      "tlg/embeddings.py": "fixed embeddings generator",
      "tlg/catalog.py": "local datasets.yml catalog ops",
      "tlg/validate.py": "dataset contract checks + determinism check",
      "conf/tokenizer/bpe_tiny.yaml": "example tokenizer training config",
      "conf/embeddings/fixed_char.yaml": "example embeddings config",
      "conf/data/toy_medium.yaml": "dataset config referencing learned tokenizer",
      "tests/unit/test_bpe_train.py": "unit tests for tokenizer training",
      "tests/unit/test_tok_apply.py": "unit tests for apply determinism",
      "tests/unit/test_dicts.py": "unit tests for dictionary generator",
      "tests/unit/test_embeddings.py": "unit tests for embeddings generator",
      "tests/integration/test_build_with_tok.py": "integration: build + apply",
      "tests/integration/test_catalog_validate.py": "integration: catalog + validate",
      "tests/e2e/test_smoke_a2.py": "e2e smoke: train tiny BPE, build dataset using it"
    }
  },
  "interfaces": {
    "cli": [
      {
        "cmd": "tlg tok train",
        "args": {
          "conf": "path to tokenizer config (required)",
          "data": "training corpus path JSONL (text field) or dir",
          "out": "output dir for tokenizer artifacts",
          "seed": "PRNG seed",
          "algorithm": "bpe|wordpiece"
        },
        "outputs": [
          "vocab.json",
          "merges.txt|sp.model",
          "tokenizer_manifest.json"
        ]
      },
      {
        "cmd": "tlg tok apply",
        "args": {
          "model": "path to tokenizer model",
          "in": "input jsonl",
          "out": "output jsonl|parquet",
          "field": "text|src|tgt",
          "ids": true
        },
        "behavior": "Appends tokens and/or ids fields; preserves original schema."
      },
      {
        "cmd": "tlg dict build",
        "args": {
          "conf": "dict YAML",
          "out": "output path",
          "seed": "optional"
        },
        "behavior": "Builds JSON dictionary with version + hash"
      },
      {
        "cmd": "tlg embed build",
        "args": {
          "conf": "embeddings YAML",
          "out": "dir"
        },
        "behavior": "Produces deterministic fixed embeddings parquet + manifest"
      },
      {
        "cmd": "tlg validate",
        "args": {
          "path": "out/<run>"
        },
        "behavior": "Schema + hash consistency checks"
      },
      {
        "cmd": "tlg catalog add",
        "args": {
          "path": "out/<run>"
        },
        "behavior": "Append/merge into catalog/datasets.yml"
      }
    ]
  },
  "configs": {
    "examples": [
      {
        "file": "conf/tokenizer/bpe_tiny.yaml"
      },
      {
        "file": "conf/embeddings/fixed_char.yaml"
      },
      {
        "file": "conf/data/toy_medium.yaml"
      }
    ]
  },
  "dataset_contracts": {
    "version": "1.1",
    "augmentations": {
      "tokenized_fields": [
        "tokens",
        "ids"
      ],
      "meta_additions": [
        "tokenizer_name",
        "tokenizer_hash",
        "dict_hash",
        "embeddings_name",
        "embeddings_hash"
      ]
    },
    "hashing_updates": {
      "tokenizer_hash": "sha256 over tokenizer model files (ordered)",
      "dict_hash": "sha256 of normalized dictionary JSON",
      "embeddings_hash": "sha256 over embeddings parquet bytes",
      "dataset_hash_note": "Hash includes any additional fields (tokens/ids) when present"
    }
  },
  "mlflow_contract": {
    "params": [
      "tokenizer_name",
      "tokenizer_hash",
      "dict_hash",
      "embeddings_hash",
      "parallel_workers",
      "streaming_writer"
    ],
    "artifacts": [
      "manifest.json",
      "stats.json",
      "tokenizer_manifest.json (if trained)",
      "catalog_snapshot.yml"
    ],
    "tags": {
      "stage": "A2",
      "component": "tlg-data-gen"
    }
  },
  "clear_metrics": {
    "description": "SLIs/SLOs for A2 (extend A1)",
    "slis": [
      {
        "name": "tokenizer_train_determinism",
        "unit": "%",
        "how": "Train 3x with same seed; identical merges/vocab -> success rate"
      },
      {
        "name": "oov_rate",
        "unit": "%",
        "how": "On validation split for learned tokenizer"
      },
      {
        "name": "tok_apply_throughput",
        "unit": "records/min",
        "how": "apply on toy_medium train split"
      },
      {
        "name": "gen_throughput_parallel",
        "unit": "records/min",
        "how": "parallel build-data vs A1 baseline"
      },
      {
        "name": "catalog_write_success",
        "unit": "%",
        "how": "catalog add without conflicts"
      }
    ],
    "slos": {
      "tokenizer_train_determinism": 100,
      "oov_rate": 1.0,
      "tok_apply_throughput": 3000,
      "gen_throughput_parallel": 4000,
      "catalog_write_success": 100
    }
  },
  "tests": {
    "pyramid": {
      "unit": {
        "target": ">= 28 tests",
        "examples": [
          "BPE trainer tie-break rules yield stable merges",
          "Tokenizer apply is pure/deterministic",
          "Dictionary builder respects seed and schema",
          "Embeddings generator returns fixed vectors for same seed",
          "Validator catches schema/hash mismatches"
        ]
      },
      "integration": {
        "target": ">= 8 tests",
        "examples": [
          "Train tiny BPE on toy_small, apply to dataset",
          "Build embeddings and reference in manifest",
          "Catalog add merges entries idempotently",
          "MinIO/MLflow optional push guarded by flags"
        ]
      },
      "e2e": {
        "target": ">= 1 smoke",
        "smoke": {
          "steps": [
            "tlg tok train conf=conf/tokenizer/bpe_tiny.yaml data=fixtures/corpus_toy.jsonl out=artifacts/tokenizers/bpe_tiny",
            "tlg build-data conf=conf/data/toy_medium.yaml out=out/a2",
            "tlg tok apply model=artifacts/tokenizers/bpe_tiny in=out/a2/train.jsonl out=out/a2_tok/train.tok.jsonl field=text ids=true",
            "tlg validate path=out/a2",
            "assert manifest.json contains tokenizer_hash and dataset_hash"
          ]
        }
      }
    }
  },
  "quality_gates": {
    "pre_commit": [
